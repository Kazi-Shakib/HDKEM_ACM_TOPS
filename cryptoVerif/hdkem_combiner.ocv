(* ============================================================
 * HDKEM combiner + ideal authenticated Finished component
 * CryptoVerif ORACLE front-end
 *
 * PURPOSE
 * -------
 * VERIFIED COMPONENT.
 *
 * The INRIA CryptoVerif run reached:
 *
 *     RESULT Proved ... ServerAccepted ==> ClientCombined
 *     All queries proved.
 *
 * This file checks a non-vacuous NON-INJECTIVE agreement property
 * for the HDKEM combiner and Finished/key-confirmation layer.
 *
 * The client and server are separate adversary-mediated oracle
 * sessions. The server accepts only when the adversary supplies
 * a confirmation tag that was previously generated by the client
 * for the SAME:
 *
 *     - session identifier,
 *     - transcript/context,
 *     - derived session key.
 *
 *
 * WHY THIS FILE USES AN IDEAL FINISHED TABLE
 * -------------------------------------------
 * A bare declaration
 *
 *     fun Finished(K,s,c): finishedTag.
 *
 * is not sufficient to prove:
 *
 *     ServerAccepted ==> ClientCombined.
 *
 * Without a PRF/MAC/unforgeability assumption, CryptoVerif has
 * no cryptographic basis for concluding that a received valid tag
 * originated from the client.
 *
 * Therefore this component models the POST-IDEALIZATION Finished
 * functionality directly:
 *
 *     - the client samples a fresh large confirmation tag;
 *     - the tag is recorded in a private table together with
 *       (sid,context,K);
 *     - the server accepts only if the supplied tag occurs in
 *       that table with exactly those values.
 *
 * This is the ideal-world functionality obtained after applying
 * the Finished MAC/PRF authenticity assumption.
 *
 *
 * SECURITY BOUNDARY
 * -----------------
 * This file proves authenticated key-confirmation AGREEMENT in
 * the ideal Finished world.
 *
 * It does NOT prove:
 *
 *   - that the concrete Finished construction is a secure MAC;
 *   - that the concrete Finished construction is a PRF;
 *   - pseudorandomness of Combine;
 *   - robustness of the split-key PRF combiner;
 *   - eCK session-key indistinguishability.
 *
 * Those are separate primitive/security assumptions and must be
 * mechanized separately or stated explicitly in the HDKEM proof.
 *
 *
 * NON-VACUITY
 * -----------
 * The adversary genuinely mediates between client and server:
 *
 *   OS1() -> (s,c)
 *       attacker
 *   OC(s,c) -> f
 *       attacker
 *   OS2(fIn)
 *
 * OS2 receives fIn as an explicit adversary-controlled argument.
 * The server does not close over the client's returned tag.
 * ============================================================ *)


(* ============================================================
 * Session bounds
 * ============================================================ *)

param NC.
param NS.


(* ============================================================
 * Types
 * ============================================================ *)

type sid [large,fixed].

type kemkey [large,fixed].
type dhkey [large,fixed].
type sourcekey [large,fixed].

type context [bounded].
type sessionkey [large,fixed].

(* A large fixed type makes accidental guessing negligible in the
 * intended computational interpretation.
 *)
type finishedTag [large,fixed].


(* ============================================================
 * Abstract split-key combiner
 *
 * This declaration provides only the functional protocol
 * interface. No PRF or robustness assumption is encoded here.
 * ============================================================ *)

fun Combine(
    kemkey,
    dhkey,
    sourcekey,
    context
):sessionkey.


(* ============================================================
 * Ideal Finished-authentication table
 *
 * FinishedIssued(s,c,K,f) means that the honest client generated
 * confirmation tag f for exactly (s,c,K).
 *
 * Only the client inserts into this table.
 * The adversary cannot insert entries.
 * ============================================================ *)

table FinishedIssued(
    sid,
    context,
    sessionkey,
    finishedTag
).


(* ============================================================
 * Events
 * ============================================================ *)

event ClientCombined(
    sid,
    context,
    sessionkey,
    finishedTag
).

event ServerAccepted(
    sid,
    context,
    sessionkey,
    finishedTag
).


(* ============================================================
 * Agreement query
 *
 * If the server accepts (s,c,K,f), then an honest client must
 * previously have constructed the same K for the same session
 * and context and issued exactly f.
 *
 * This is non-injective agreement. Replaying the same client
 * confirmation may therefore yield multiple server acceptances.
 * ============================================================ *)

query s:sid, c:context, K:sessionkey, f:finishedTag;

    event(
        ServerAccepted(
            s,
            c,
            K,
            f
        )
    )

    ==>

    event(
        ClientCombined(
            s,
            c,
            K,
            f
        )
    ).


(* ============================================================
 * Client
 *
 * The client receives the server-selected session identifier and
 * context through an adversary-mediated oracle call.
 *
 * It derives K from the three HDKEM component keys, samples an
 * ideal authenticated Finished tag, records the exact tuple in
 * FinishedIssued, emits ClientCombined, and returns the tag.
 * ============================================================ *)

let processC(
    k1:kemkey,
    k2:dhkey,
    k3:sourcekey
) =

    foreach iC <= NC do

    OC(
        s:sid,
        c:context
    ) :=

        K <- Combine(
            k1,
            k2,
            k3,
            c
        );

        f <-R finishedTag;

        insert FinishedIssued(
            s,
            c,
            K,
            f
        );

        event ClientCombined(
            s,
            c,
            K,
            f
        );

        return(
            f
        ).


(* ============================================================
 * Server
 *
 * OS1 creates fresh session state and releases (s,c).
 *
 * OS2 receives an arbitrary tag fIn from the adversary.
 * The server derives its own K and accepts only if fIn was
 * previously issued by an honest client for exactly (s,c,K).
 *
 * There is no closure over a client tag.
 * ============================================================ *)

let processS(
    k1:kemkey,
    k2:dhkey,
    k3:sourcekey
) =

    foreach iS <= NS do

    OS1() :=

        s <-R sid;
        c <-R context;

        return(
            s,
            c
        );


        OS2(
            fIn:finishedTag
        ) :=

            K <- Combine(
                k1,
                k2,
                k3,
                c
            );

            get FinishedIssued(
                sStored,
                cStored,
                KStored,
                fStored
            )
            suchthat
                sStored = s
                &&
                cStored = c
                &&
                KStored = K
                &&
                fStored = fIn
            in

                event ServerAccepted(
                    s,
                    c,
                    K,
                    fIn
                );

                return()

            else

                return().


(* ============================================================
 * Main process
 *
 * This component isolates combiner/Finished agreement, so the
 * three component keys are sampled as secret shared inputs.
 *
 * The full HDKEM model replaces these samples by outputs of the
 * KEM, NIKE, and source components respectively.
 * ============================================================ *)

process

    Ostart() :=

        k1 <-R kemkey;
        k2 <-R dhkey;
        k3 <-R sourcekey;

        return();

        (
            run processC(
                k1,
                k2,
                k3
            )

          |

            run processS(
                k1,
                k2,
                k3
            )
        )
